{
  "name": "meteor-persistent-session",
  "private": true,
  "version": "0.5.0",
  "description": "Persistently store Session data on the client",
  "main": "package.js",
  "directories": {
    "lib": "lib",
    "test": "tests"
  },
  "scripts": {
    "test": "TEST_BROWSER_DRIVER=playwright meteor test-packages --once --driver-package meteortesting:mocha ./",
    "test:watch": "TEST_BROWSER_DRIVER=playwright meteor test-packages --driver-package meteortesting:mocha ./ --port 3010",
    "publish:meteor": "meteor publish",
    "tsc": "tsc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a4xrbj1/meteor-persistent-session.git"
  },
  "author": "Numero Pte. Ltd.",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/a4xrbj1/meteor-persistent-session/issues"
  },
  "homepage": "https://github.com/a4xrbj1/meteor-persistent-session#readme",
  "devDependencies": {
    "@types/meteor": "^2.9.11",
    "@types/mocha": "^10.0.10",
    "playwright": "^1.62.1",
    "typescript": "^6.0.3"
  }
}
